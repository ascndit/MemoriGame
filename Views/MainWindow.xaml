<Window x:Class="MemoriGame.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎮 MEMORI - Найди пару" 
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="White"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="20" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MusicButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="20" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Button Content="✕" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Margin="0,10,15,0"
                Background="Transparent"
                Foreground="White"
                FontSize="18"
                FontWeight="Bold"
                BorderThickness="0"
                Cursor="Hand"
                Click="CloseButton_Click"
                Width="30" Height="30"
                Panel.ZIndex="100"/>

        <!-- Кнопка музыки -->
        <Button x:Name="MusicToggleBtn" Content="🔊" Click="MusicToggleBtn_Click"
                HorizontalAlignment="Left" VerticalAlignment="Top" 
                Margin="15,10,0,0" Style="{StaticResource MusicButton}"
                Panel.ZIndex="100"/>

        <Grid x:Name="GamePanel" Visibility="Collapsed" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#CC1a1a2e" CornerRadius="20" Margin="5" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#2d2d4a" CornerRadius="10" Margin="3" Padding="8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="👤 " FontSize="16"/>
                            <TextBlock x:Name="PlayerNameText" FontSize="14" Foreground="#FFE66D" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#2d2d4a" CornerRadius="10" Margin="3" Padding="8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🎯 " FontSize="16"/>
                            <TextBlock x:Name="MovesText" FontSize="14" Foreground="#FF6B6B" FontWeight="Bold">0</TextBlock>
                            <TextBlock Text=" ходов" FontSize="12" Foreground="White" Margin="3,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#2d2d4a" CornerRadius="10" Margin="3" Padding="8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="✅ " FontSize="16"/>
                            <TextBlock x:Name="PairsFoundText" FontSize="14" Foreground="#4ECDC4" FontWeight="Bold">0</TextBlock>
                            <TextBlock Text=" пар" FontSize="12" Foreground="White" Margin="3,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="#2d2d4a" CornerRadius="10" Margin="3" Padding="8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⏰ " FontSize="16"/>
                            <TextBlock x:Name="TimeText" FontSize="14" Foreground="#FFE66D" FontWeight="Bold">00:00</TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="5">
                <WrapPanel x:Name="CardsPanel" HorizontalAlignment="Center"/>
            </ScrollViewer>

            <Border Grid.Row="3" Background="#CC1a1a2e" CornerRadius="20" Margin="5" Padding="8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="NewGameBtn" Content="🔄 Новая игра" Click="NewGameBtn_Click"
                            Background="#FF6B6B" Style="{StaticResource GlassButton}"/>
                    <Button x:Name="ShowLeaderboardBtn" Content="🏆 Рекорды" Click="ShowLeaderboard_Click"
                            Background="#4ECDC4" Style="{StaticResource GlassButton}"/>
                    <Button x:Name="BackToMenuBtn" Content="🏠 На главную" Click="BackToMenuBtn_Click"
                            Background="#F39C12" Style="{StaticResource GlassButton}"/>
                    <Button x:Name="ExitGameBtn" Content="❌ Выход" Click="ExitGameBtn_Click"
                            Background="#DC143C" Style="{StaticResource GlassButton}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="StartDialog" Background="#CC000000">
            <Grid>
                <Border Width="800" Height="530" CornerRadius="25" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="White">

                    <Grid Margin="25">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="🎮 MEMORI" FontSize="36" FontWeight="Bold" 
                                       Foreground="#FF6B6B" HorizontalAlignment="Center"/>
                            <TextBlock Text="Найди пару - тренируй память!" 
                                       FontSize="13" Foreground="#666" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="280"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                <Border Background="#F5F5F5" CornerRadius="12" Padding="15" Margin="0,6">
                                    <StackPanel>
                                        <TextBlock Text="👤 Ваше имя" FontSize="13" FontWeight="Bold" Foreground="#333" Margin="0,0,0,5"/>
                                        <TextBox x:Name="NameTextBox" Height="38" FontSize="14"
                                                 Background="White" BorderBrush="#FF6B6B" BorderThickness="2"
                                                 Padding="10,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F5F5F5" CornerRadius="12" Padding="15" Margin="0,6">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ Сложность" FontSize="13" FontWeight="Bold" Foreground="#333" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="DifficultyCombo" Height="38" FontSize="13"
                                                  Background="White" BorderBrush="#FF6B6B" BorderThickness="2"
                                                  Padding="8,0" SelectionChanged="DifficultyCombo_SelectionChanged">
                                            <ComboBoxItem Content="😊 Easy (2x2)" Tag="Easy"/>
                                            <ComboBoxItem Content="😐 Medium (4x4)" Tag="Medium" IsSelected="True"/>
                                            <ComboBoxItem Content="🤔 Hard (6x6)" Tag="Hard"/>
                                            <ComboBoxItem Content="🔥 Expert (8x8)" Tag="Expert"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F5F5F5" CornerRadius="12" Padding="15" Margin="0,6">
                                    <StackPanel>
                                        <TextBlock Text="📖 Правила" FontSize="13" FontWeight="Bold" Foreground="#333" Margin="0,0,0,8"/>
                                        <TextBlock Text="• Открывай карточки по две" FontSize="11" Foreground="#555" Margin="0,2"/>
                                        <TextBlock Text="• Найди одинаковые пары" FontSize="11" Foreground="#555" Margin="0,2"/>
                                        <TextBlock Text="• Меньше ходов - лучше результат" FontSize="11" Foreground="#555" Margin="0,2"/>
                                        <TextBlock Text="• Топ-5 попадают в рекорды" FontSize="11" Foreground="#FF6B6B" Margin="0,5,0,0" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="StartGameBtn" Content="НАЧАТЬ ИГРУ" Click="StartGameBtn_Click"
                                        Height="48" FontSize="15" FontWeight="Bold"
                                        Background="#FF6B6B" Foreground="White" Cursor="Hand" Margin="0,15,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#1a1a2e" CornerRadius="15" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="🏆 ТОП ИГРОКОВ" FontSize="14" FontWeight="Bold" 
                                               Foreground="#FFE66D" HorizontalAlignment="Center"/>
                                    <Border Height="1" Background="#FFE66D" Margin="0,8,0,12"/>
                                    <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="LeaderboardPanel"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>